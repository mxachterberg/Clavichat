{
  "name": "securecom",
  "productName": "SecureCom",
  "version": "1.3.1",
  "description": "Ende-zu-Ende verschlüsselt schreiben, telefonieren und den Bildschirm teilen.",
  "author": "Max Achterberg",
  "license": "MIT",
  "homepage": "https://achterberg.dev/app/securecom/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mxachterberg/securecom.git"
  },
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "smoke": "electron . --smoke",
    "build": "electron-builder --win nsis portable --publish never",
    "postbuild": "node scripts/clean-dist.js dist",
    "server": "electron host/main.js",
    "smoke:server": "electron host/main.js --smoke",
    "php": "node scripts/fetch-php.js",
    "build:server": "electron-builder --config host/builder.json --win nsis portable --publish never",
    "postbuild:server": "node scripts/clean-dist.js dist-server"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.achterberg.securecom",
    "productName": "SecureCom",
    "copyright": "© 2026 Max Achterberg",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "updater.js",
      "preload.js",
      "picker-preload.js",
      "app.html",
      "window.css",
      "picker.html",
      "picker.js",
      "picker.css",
      "package.json",
      "build/icon.ico",
      { "from": "../server/assets", "to": "assets", "filter": ["**/*"] }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SecureCom",
      "installerLanguages": ["de_DE", "en_US"],
      "language": "1031",
      "artifactName": "SecureCom-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SecureCom-portable.${ext}"
    }
  }
}
