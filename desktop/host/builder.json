{
  "appId": "dev.achterberg.clavichat.server",
  "productName": "Clavichat Server",
  "copyright": "© 2026 Max Achterberg",
  "directories": {
    "output": "dist-server",
    "buildResources": "build"
  },
  "extraMetadata": {
    "main": "host/main.js",
    "name": "clavichat-server",
    "productName": "Clavichat Server",
    "description": "Clavichat-Server für das eigene Netz – mit HTTPS, Daten bleiben auf diesem Rechner."
  },
  "files": [
    "package.json",
    "window.css",
    "build/icon.ico",
    "host/main.js",
    "host/preload.js",
    "host/cert.js",
    "host/window.html",
    "host/host.css",
    "host/host.js"
  ],
  "extraResources": [
    { "from": "host/php", "to": "php", "filter": ["**/*"] },
    { "from": "../server", "to": "server", "filter": ["**/*", "!storage", "!storage/**", "!config.php"] }
  ],
  "win": {
    "target": ["nsis", "portable"],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "Clavichat Server",
    "installerLanguages": ["de_DE", "en_US"],
    "language": "1031",
    "artifactName": "Clavichat-Server-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "Clavichat-Server-portable.${ext}"
  }
}
